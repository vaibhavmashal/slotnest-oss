{
  "name": "slotnest",
  "version": "0.1.0",
  "private": true,
  "license": "Apache-2.0",
  "type": "module",
  "scripts": {
    "dev": "next dev -p 3100",
    "build": "next build",
    "start": "next start -p 3100",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "db:up": "docker compose up -d db mail",
    "db:migrate": "tsx scripts/migrate.ts",
    "db:seed": "tsx scripts/seed.ts",
    "test:int": "vitest run --config vitest.int.config.ts",
    "worker": "tsx --tsconfig tsconfig.json scripts/worker.ts",
    "stripe:setup": "tsx scripts/stripe-setup.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^1.4.0",
    "drizzle-orm": "^0.45.4",
    "luxon": "^3.7.2",
    "next": "^16.4.3",
    "nodemailer": "^10.3.1",
    "pg-boss": "^12.38.0",
    "postgres": "^4.0.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "stripe": "^23.1.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/luxon": "^3.7.6",
    "@types/node": "^26.6.6",
    "@types/nodemailer": "^8.0.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^5.0.5"
  }
}
