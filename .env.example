# ---- Core ----
DATABASE_URL=postgres://slotnest:slotnest@localhost:5446/slotnest
APP_URL=http://localhost:3100
# 32 random bytes, base64. Encrypts OAuth tokens at rest. Generate: openssl rand -base64 32
TOKEN_ENCRYPTION_KEY=
# Set to "false" to run the job worker separately (npm run worker).
RUN_WORKER=true
# Where uploaded logos and profile photos are stored (default: ./storage/assets). Use a persistent, backed-up path in production.
ASSET_DIR=
# Without Stripe: whether paid-only features (hiding "Powered by Slotnest") are allowed. "false" simulates a free plan.
UNBILLED_PAID_FEATURES=true

# ---- Email ----
# log | smtp | postmark. Local dev: smtp with the Mailpit container (UI at http://localhost:8026).
# Production: Resend over SMTP, e.g. smtps://resend:<API key>@smtp.resend.com:2465 (see SETUP.md §2).
EMAIL_PROVIDER=smtp
SMTP_URL=smtp://localhost:1026
EMAIL_FROM="Slotnest <bookings@localhost>"
POSTMARK_SERVER_TOKEN=

# ---- Google Calendar + Meet (OAuth client, Web application) ----
# Redirect URI: ${APP_URL}/api/integrations/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ---- Microsoft 365 / Outlook (Entra ID app registration) ----
# Redirect URI: ${APP_URL}/api/integrations/microsoft/callback
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
MICROSOFT_TENANT=common

# ---- Zoom (General app, user-managed OAuth) ----
# Redirect URI: ${APP_URL}/api/integrations/zoom/callback
ZOOM_CLIENT_ID=
ZOOM_CLIENT_SECRET=

# ---- Stripe billing (one-time setup fee + yearly maintenance) ----
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_SOLO_SETUP=
STRIPE_PRICE_SOLO_YEARLY=
STRIPE_PRICE_TEAM_SETUP=
STRIPE_PRICE_TEAM_YEARLY=

# ---- Webhooks ----
# Local testing only: lets webhooks reach http:// and private addresses (e.g. a receiver on localhost). Never set in production.
# WEBHOOKS_ALLOW_PRIVATE=1

# ---- AI scheduling assistant (optional; the dashboard's Assistant page is hidden without a key) ----
# An Anthropic API key from https://platform.claude.com. ASSISTANT_MODEL defaults to claude-opus-5-5.
ANTHROPIC_API_KEY=
# ASSISTANT_MODEL=claude-opus-5-5
# Messages each user can send per day (default 50).
# ASSISTANT_DAILY_LIMIT=50

# Who runs this copy, named in the footer, privacy policy and terms. CONTACT_EMAIL defaults to the first ADMIN_EMAILS address.
COMPANY_NAME=
CONTACT_EMAIL=

# Sign-in emails that can open the admin page (/dashboard/admin), comma-separated. Empty = no admin page.
ADMIN_EMAILS=
