# Settings for the Docker stack in deploy/compose.yml. scripts/selfhost.sh copies this to deploy/.env and fills in the
# generated secrets; edit the rest by hand (chmod 600). SETUP.md says where each value comes from.

# ---- Stack ----
# Your domain, pointed at this server (an A record). Caddy gets the HTTPS certificate. Use "localhost" to try it out.
SITE_HOST=book.example.com
# openssl rand -hex 24
POSTGRES_PASSWORD=
APP_TAG=latest

# ---- Core ----
APP_URL=https://book.example.com
# openssl rand -base64 32. Losing it means every user reconnects their calendars: keep a copy in a password manager.
TOKEN_ENCRYPTION_KEY=
RUN_WORKER=true
# Without Stripe, every account gets every feature. Set to "false" only if you run your own Stripe billing.
UNBILLED_PAID_FEATURES=true

# ---- Who runs this copy (footer, privacy policy, terms) and who can open /dashboard/admin ----
COMPANY_NAME=
CONTACT_EMAIL=
ADMIN_EMAILS=

# ---- Email (sign-in links, confirmations, reminders) ----
# "log" prints emails, sign-in links included, to the app's log (docker compose logs app). For real email use SMTP,
# e.g. Resend: smtps://resend:<API key>@smtp.resend.com:2465 (see SETUP.md §2).
EMAIL_PROVIDER=log
SMTP_URL=
EMAIL_FROM="Slotnest <bookings@book.example.com>"

# ---- Google Calendar + Meet ----
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ---- Microsoft 365 / Outlook ----
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
MICROSOFT_TENANT=common

# ---- Zoom ----
ZOOM_CLIENT_ID=
ZOOM_CLIENT_SECRET=

# ---- Stripe (optional: paid bookings, or your own billing) ----
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_SOLO_SETUP=
STRIPE_PRICE_SOLO_YEARLY=
STRIPE_PRICE_TEAM_SETUP=
STRIPE_PRICE_TEAM_YEARLY=
